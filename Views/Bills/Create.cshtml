@{
    ViewData["Title"] = "Create Bill";
}

<div class="container-fluid">

    <div class="mb-4">

        <h1 class="fw-bold">
            Create Bill
        </h1>

        <p class="text-muted">
            Generate a bill for a guest booking.
        </p>

    </div>


    <div class="row">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Booking
                            </label>

                            <select name="bookingId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Booking --
                                </option>

                                @if (ViewBag.Bookings != null)
                                {
                                    foreach (var booking in ViewBag.Bookings)
                                    {
                                        <option value="@booking.Id"
                                                selected="@(ViewBag.SelectedBookingId != null &&
                                                                                                       ViewBag.SelectedBookingId == booking.Id)">
                                            Booking #@booking.Id -
                                            @(booking.Customer?.FullName ?? "Unknown") -
                                            Room @(booking.Room?.RoomNumber ?? "N/A")
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Additional Charge
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    Rs.
                                </span>

                                <input type="number"
                                       name="additionalCharge"
                                       value="0"
                                       min="0"
                                       step="0.01"
                                       class="form-control" />

                            </div>

                            <div class="form-text">
                                Enter 0 if there are no additional charges.
                            </div>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Create Bill
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>