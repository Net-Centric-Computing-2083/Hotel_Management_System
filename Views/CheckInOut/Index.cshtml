@model IEnumerable<HotelManagementSystem.Models.Booking>

@{
    ViewData["Title"] = "Check-In / Check-Out";

    var pendingCheckIns = Model
        .Where(b => b.CheckIn == null)
        .OrderBy(b => b.CheckInDate)
        .ToList();

    var activeGuests = Model
        .Where(b => b.CheckIn != null && b.CheckIn.CheckOut == null)
        .OrderBy(b => b.CheckOutDate)
        .ToList();

    var completedStays = Model
        .Where(b => b.CheckIn != null && b.CheckIn.CheckOut != null)
        .OrderByDescending(b => b.CheckIn!.CheckOut!.CheckOutDateTime)
        .ToList();
}

<div class="container py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-primary fw-semibold small text-uppercase">
                Front Desk
            </div>

            <h2 class="fw-bold mb-1">
                Check-In / Check-Out
            </h2>

            <p class="text-muted mb-0">
                Manage guest arrivals, current stays and departures.
            </p>
        </div>

        <div class="text-end">
            <div class="text-muted small">
                Today's Date
            </div>

            <div class="fw-semibold">
                @DateTime.Now.ToString("dd MMM yyyy")
            </div>
        </div>

    </div>


    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <strong>Success:</strong>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <strong>Error:</strong>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <!-- Pending -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Pending Check-Ins
                    </div>

                    <div class="fs-2 fw-bold text-primary">
                        @pendingCheckIns.Count
                    </div>

                    <div class="small text-muted">
                        Guests ready to arrive
                    </div>

                </div>

            </div>

        </div>


        <!-- Current -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Current Guests
                    </div>

                    <div class="fs-2 fw-bold text-success">
                        @activeGuests.Count
                    </div>

                    <div class="small text-muted">
                        Guests currently staying
                    </div>

                </div>

            </div>

        </div>


        <!-- Completed -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Completed Check-Outs
                    </div>

                    <div class="fs-2 fw-bold text-secondary">
                        @completedStays.Count
                    </div>

                    <div class="small text-muted">
                        Completed stays
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- PENDING CHECK-INS -->
    <!-- ========================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-primary text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-0 fw-semibold">
                        Pending Check-Ins
                    </h5>

                    <small>
                        Guests who have booked but have not arrived yet
                    </small>

                </div>

                <span class="badge bg-light text-primary">
                    @pendingCheckIns.Count
                </span>

            </div>

        </div>


        @if (pendingCheckIns.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Room Type</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th class="text-end">Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var booking in pendingCheckIns)
                        {
                            <tr>

                                <!-- Guest -->
                                <td>

                                    <div class="fw-semibold">
                                        @booking.Customer?.FullName
                                    </div>

                                    <div class="small text-muted">
                                        Booking #@booking.Id
                                    </div>

                                </td>


                                <!-- Room -->
                                <td>

                                    <span class="fw-semibold">
                                        Room @booking.Room?.RoomNumber
                                    </span>

                                </td>


                                <!-- Room Type -->
                                <td>

                                    @booking.Room?.RoomType?.Name

                                </td>


                                <!-- Check In Date -->
                                <td>

                                    @booking.CheckInDate.ToString("dd MMM yyyy")

                                </td>


                                <!-- Check Out Date -->
                                <td>

                                    @booking.CheckOutDate.ToString("dd MMM yyyy")

                                </td>


                                <!-- Action -->
                                <td class="text-end">

                                    <form asp-controller="CheckInOut"
                                          asp-action="CheckIn"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="bookingId"
                                               value="@booking.Id" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm px-3"
                                                onclick="return confirm('Check in this guest?');">

                                            Check In

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="card-body text-center py-5">

                <div class="fs-1 mb-2">
                    ✓
                </div>

                <h6 class="fw-semibold">
                    No pending check-ins
                </h6>

                <p class="text-muted mb-0">
                    All booked guests have either checked in or completed their stay.
                </p>

            </div>
        }

    </div>


    <!-- ========================================= -->
    <!-- CURRENT GUESTS -->
    <!-- ========================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-success text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-0 fw-semibold">
                        Current Guests
                    </h5>

                    <small>
                        Guests currently staying at the hotel
                    </small>

                </div>

                <span class="badge bg-light text-success">
                    @activeGuests.Count
                </span>

            </div>

        </div>


        @if (activeGuests.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Checked In</th>
                            <th>Scheduled Check-Out</th>
                            <th class="text-end">Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var booking in activeGuests)
                        {
                            var checkedInAt = booking.CheckIn?.CheckInDateTime;

                            <tr>

                                <!-- Guest -->
                                <td>

                                    <div class="fw-semibold">
                                        @booking.Customer?.FullName
                                    </div>

                                    <div class="small text-muted">
                                        Booking #@booking.Id
                                    </div>

                                </td>


                                <!-- Room -->
                                <td>

                                    <span class="fw-semibold">
                                        Room @booking.Room?.RoomNumber
                                    </span>

                                </td>


                                <!-- Actual Check In -->
                                <td>

                                    @if (checkedInAt.HasValue)
                                    {
                                        @checkedInAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- Scheduled Check Out -->
                                <td>

                                    @booking.CheckOutDate.ToString("dd MMM yyyy")

                                </td>


                                <!-- Action -->
                                <td class="text-end">

                                    <form asp-controller="CheckInOut"
                                          asp-action="CheckOut"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="bookingId"
                                               value="@booking.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm px-3"
                                                onclick="return confirm('Check out this guest?');">

                                            Check Out

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="card-body text-center py-5">

                <div class="fs-1 mb-2">
                    🛏️
                </div>

                <h6 class="fw-semibold">
                    No active guests
                </h6>

                <p class="text-muted mb-0">
                    There are currently no guests checked into the hotel.
                </p>

            </div>
        }

    </div>


    <!-- ========================================= -->
    <!-- COMPLETED CHECK-OUTS -->
    <!-- ========================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-secondary text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-0 fw-semibold">
                        Completed Check-Outs
                    </h5>

                    <small>
                        Guests who have completed their stay
                    </small>

                </div>

                <span class="badge bg-light text-secondary">
                    @completedStays.Count
                </span>

            </div>

        </div>


        @if (completedStays.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Check-In</th>
                            <th>Checked Out</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var booking in completedStays)
                        {
                            var checkedInAt =
                                booking.CheckIn?.CheckInDateTime;

                            var checkedOutAt =
                                booking.CheckIn?.CheckOut?.CheckOutDateTime;

                            <tr>

                                <!-- Guest -->
                                <td>

                                    <div class="fw-semibold">
                                        @booking.Customer?.FullName
                                    </div>

                                    <div class="small text-muted">
                                        Booking #@booking.Id
                                    </div>

                                </td>


                                <!-- Room -->
                                <td>

                                    <span class="fw-semibold">
                                        Room @booking.Room?.RoomNumber
                                    </span>

                                </td>


                                <!-- Check In -->
                                <td>

                                    @if (checkedInAt.HasValue)
                                    {
                                        @checkedInAt.Value.ToString(
                                            "dd MMM yyyy, hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- Check Out -->
                                <td>

                                    @if (checkedOutAt.HasValue)
                                    {
                                        @checkedOutAt.Value.ToString(
                                            "dd MMM yyyy, hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- Status -->
                                <td>

                                    <span class="badge bg-secondary">
                                        Checked Out
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="card-body text-center py-4">

                <p class="text-muted mb-0">
                    No completed check-outs yet.
                </p>

            </div>
        }

    </div>

</div>