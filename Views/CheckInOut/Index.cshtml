@model IEnumerable<HotelManagementSystem.Models.Booking>

@{
    ViewData["Title"] = "Check-In / Check-Out";

    string? search = ViewBag.Search as string;
    string? status = ViewBag.Status as string;
    string? sortOrder = ViewBag.CurrentSort as string;

    DateOnly? checkInDate = ViewBag.CheckInDate as DateOnly?;
    DateOnly? checkOutDate = ViewBag.CheckOutDate as DateOnly?;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;

    var allBookings = Model?.ToList()
        ?? new List<HotelManagementSystem.Models.Booking>();

    var pendingCheckIns = allBookings
        .Where(b => b.CheckIn == null)
        .ToList();

    var activeGuests = allBookings
        .Where(b => b.CheckIn != null &&
                    b.CheckIn.CheckOut == null)
        .ToList();

    var completedStays = allBookings
        .Where(b => b.CheckIn != null &&
                    b.CheckIn.CheckOut != null)
        .ToList();
}

<div class="container py-4">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="text-primary fw-semibold small text-uppercase">
                Front Desk
            </div>

            <h2 class="fw-bold mb-1">
                Check-In / Check-Out
            </h2>

            <p class="text-muted mb-0">
                Manage guest arrivals, current stays and departures.
            </p>

        </div>

        <div class="text-end">

            <div class="text-muted small">
                Today's Date
            </div>

            <div class="fw-semibold">
                @DateTime.Now.ToString("dd MMM yyyy")
            </div>

        </div>

    </div>


    <!-- =========================================================
         ALERTS
         ========================================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <strong>Success:</strong>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <strong>Error:</strong>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         SUMMARY CARDS
         ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- Pending -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Pending Check-Ins
                    </div>

                    <div class="fs-2 fw-bold text-primary">
                        @pendingCheckIns.Count
                    </div>

                    <div class="small text-muted">
                        Guests ready to arrive
                    </div>

                </div>

            </div>

        </div>


        <!-- Current -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Current Guests
                    </div>

                    <div class="fs-2 fw-bold text-success">
                        @activeGuests.Count
                    </div>

                    <div class="small text-muted">
                        Guests currently staying
                    </div>

                </div>

            </div>

        </div>


        <!-- Completed -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Completed Check-Outs
                    </div>

                    <div class="fs-2 fw-bold text-secondary">
                        @completedStays.Count
                    </div>

                    <div class="small text-muted">
                        Completed stays
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SEARCH / FILTER PANEL
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>

                    <h5 class="fw-bold mb-1">
                        Search & Filter
                    </h5>

                    <small class="text-muted">
                        Find guests and stays by customer, room, status or date.
                    </small>

                </div>

                <span class="badge bg-light text-dark border">
                    @totalItems record@(totalItems == 1 ? "" : "s")
                </span>

            </div>


            <form asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- SEARCH -->

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Customer name or room number" />

                    </div>


                    <!-- STATUS -->

                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Statuses
                            </option>

                            <option value="Ready"
                                    selected="@(status == "Ready")">
                                Ready for Check-In
                            </option>

                            <option value="Checked In"
                                    selected="@(status == "Checked In")">
                                Checked In
                            </option>

                            <option value="Checked Out"
                                    selected="@(status == "Checked Out")">
                                Checked Out
                            </option>

                        </select>

                    </div>


                    <!-- SORT -->

                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Sort By
                        </label>

                        <select name="sortOrder"
                                class="form-select">

                            <option value=""
                                    selected="@(string.IsNullOrEmpty(sortOrder))">
                                Newest Booking
                            </option>

                            <option value="oldest"
                                    selected="@(sortOrder == "oldest")">
                                Oldest Booking
                            </option>

                            <option value="customer_asc"
                                    selected="@(sortOrder == "customer_asc")">
                                Customer A-Z
                            </option>

                            <option value="customer_desc"
                                    selected="@(sortOrder == "customer_desc")">
                                Customer Z-A
                            </option>

                            <option value="room_asc"
                                    selected="@(sortOrder == "room_asc")">
                                Room A-Z
                            </option>

                            <option value="room_desc"
                                    selected="@(sortOrder == "room_desc")">
                                Room Z-A
                            </option>

                            <option value="checkin_asc"
                                    selected="@(sortOrder == "checkin_asc")">
                                Check-In Earliest
                            </option>

                            <option value="checkin_desc"
                                    selected="@(sortOrder == "checkin_desc")">
                                Check-In Latest
                            </option>

                            <option value="checkout_asc"
                                    selected="@(sortOrder == "checkout_asc")">
                                Check-Out Earliest
                            </option>

                            <option value="checkout_desc"
                                    selected="@(sortOrder == "checkout_desc")">
                                Check-Out Latest
                            </option>

                        </select>

                    </div>


                    <!-- ACTIONS -->

                    <div class="col-lg-2 col-md-6 d-flex align-items-end">

                        <div class="d-flex gap-2 w-100">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">
                                Search
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Reset
                            </a>

                        </div>

                    </div>

                </div>


                <!-- DATE FILTERS -->

                <hr class="my-4" />

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Check-In From
                        </label>

                        <input type="date"
                               name="checkInDate"
                               value="@(checkInDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Check-Out Until
                        </label>

                        <input type="date"
                               name="checkOutDate"
                               value="@(checkOutDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         PENDING CHECK-INS
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-primary text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-0 fw-semibold">
                        Pending Check-Ins
                    </h5>

                    <small>
                        Guests who have booked but have not arrived yet
                    </small>

                </div>

                <span class="badge bg-light text-primary">
                    @pendingCheckIns.Count
                </span>

            </div>

        </div>


        @if (pendingCheckIns.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Guest</th>
                            <th>Room</th>
                            <th>Room Type</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th class="text-end">Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var booking in pendingCheckIns)
                        {
                            <tr>

                                <td>

                                    <div class="fw-semibold">
                                        @booking.Customer?.FullName
                                    </div>

                                    <div class="small text-muted">
                                        Booking #@booking.Id
                                    </div>

                                </td>


                                <td>

                                    <span class="fw-semibold">
                                        Room @booking.Room?.RoomNumber
                                    </span>

                                </td>


                                <td>
                                    @booking.Room?.RoomType?.Name
                                </td>


                                <td>
                                    @booking.CheckInDate.ToString("dd MMM yyyy")
                                </td>


                                <td>
                                    @booking.CheckOutDate.ToString("dd MMM yyyy")
                                </td>


                                <td class="text-end">

                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@booking.Id"
                                           class="btn btn-outline-primary btn-sm">

                                            Details

                                        </a>

                                        <form asp-controller="CheckInOut"
                                              asp-action="CheckIn"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="bookingId"
                                                   value="@booking.Id" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm px-3"
                                                    onclick="return confirm('Check in this guest?');">

                                                Check In

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="card-body text-center py-5">

                <div class="fs-1 mb-2">
                    ✓
                </div>

                <h6 class="fw-semibold">
                    No pending check-ins
                </h6>

                <p class="text-muted mb-0">
                    All booked guests have either checked in or completed their stay.
                </p>

            </div>
        }

    </div>


    <!-- =========================================================
         CURRENT GUESTS
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-success text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-0 fw-semibold">
                        Current Guests
                    </h5>

                    <small>
                        Guests currently staying at the hotel
                    </small>

                </div>

                <span class="badge bg-light text-success">
                    @activeGuests.Count
                </span>

            </div>

        </div>


        @if (activeGuests.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Guest</th>
                            <th>Room</th>
                            <th>Checked In</th>
                            <th>Scheduled Check-Out</th>
                            <th class="text-end">Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var booking in activeGuests)
                        {
                            var checkedInAt =
                                booking.CheckIn?.CheckInDateTime;

                            <tr>

                                <td>

                                    <div class="fw-semibold">
                                        @booking.Customer?.FullName
                                    </div>

                                    <div class="small text-muted">
                                        Booking #@booking.Id
                                    </div>

                                </td>


                                <td>

                                    <span class="fw-semibold">
                                        Room @booking.Room?.RoomNumber
                                    </span>

                                </td>


                                <td>

                                    @if (checkedInAt.HasValue)
                                    {
                                        @checkedInAt.Value.ToString(
                                            "dd MMM yyyy, hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <td>

                                    @booking.CheckOutDate.ToString(
                                        "dd MMM yyyy")

                                </td>


                                <td class="text-end">

                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@booking.Id"
                                           class="btn btn-outline-primary btn-sm">

                                            Details

                                        </a>

                                        <form asp-controller="CheckInOut"
                                              asp-action="CheckOut"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="bookingId"
                                                   value="@booking.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm px-3"
                                                    onclick="return confirm('Check out this guest?');">

                                                Check Out

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="card-body text-center py-5">

                <div class="fs-1 mb-2">
                    🛏️
                </div>

                <h6 class="fw-semibold">
                    No active guests
                </h6>

                <p class="text-muted mb-0">
                    There are currently no guests checked into the hotel.
                </p>

            </div>
        }

    </div>


    <!-- =========================================================
         COMPLETED CHECK-OUTS
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-secondary text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-0 fw-semibold">
                        Completed Check-Outs
                    </h5>

                    <small>
                        Guests who have completed their stay
                    </small>

                </div>

                <span class="badge bg-light text-secondary">
                    @completedStays.Count
                </span>

            </div>

        </div>


        @if (completedStays.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Guest</th>
                            <th>Room</th>
                            <th>Check-In</th>
                            <th>Checked Out</th>
                            <th>Status</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var booking in completedStays)
                        {
                            var checkedInAt =
                                booking.CheckIn?.CheckInDateTime;

                            var checkedOutAt =
                                booking.CheckIn?.CheckOut?.CheckOutDateTime;

                            <tr>

                                <td>

                                    <div class="fw-semibold">
                                        @booking.Customer?.FullName
                                    </div>

                                    <div class="small text-muted">
                                        Booking #@booking.Id
                                    </div>

                                </td>


                                <td>

                                    <span class="fw-semibold">
                                        Room @booking.Room?.RoomNumber
                                    </span>

                                </td>


                                <td>

                                    @if (checkedInAt.HasValue)
                                    {
                                        @checkedInAt.Value.ToString(
                                            "dd MMM yyyy, hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (checkedOutAt.HasValue)
                                    {
                                        @checkedOutAt.Value.ToString(
                                            "dd MMM yyyy, hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <td>

                                    <span class="badge bg-secondary">
                                        Checked Out
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="card-body text-center py-4">

                <p class="text-muted mb-0">
                    No completed check-outs yet.
                </p>

            </div>
        }

    </div>


    <!-- =========================================================
         PAGINATION
         ========================================================= -->

    @if (totalPages > 1)
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <div class="text-muted small">

                        Showing page
                        <strong>@currentPage</strong>
                        of
                        <strong>@totalPages</strong>

                    </div>


                    <nav aria-label="Check-in/check-out pagination">

                        <ul class="pagination mb-0">

                            <!-- PREVIOUS -->

                            @if (currentPage > 1)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@search"
                                       asp-route-status="@status"
                                       asp-route-checkInDate="@checkInDate"
                                       asp-route-checkOutDate="@checkOutDate"
                                       asp-route-sortOrder="@sortOrder"
                                       asp-route-page="@(currentPage - 1)">

                                        Previous

                                    </a>

                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        Previous
                                    </span>

                                </li>
                            }


                            <!-- PAGE NUMBERS -->

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                if (i == currentPage)
                                {
                                    <li class="page-item active">

                                        <span class="page-link">
                                            @i
                                        </span>

                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-search="@search"
                                           asp-route-status="@status"
                                           asp-route-checkInDate="@checkInDate"
                                           asp-route-checkOutDate="@checkOutDate"
                                           asp-route-sortOrder="@sortOrder"
                                           asp-route-page="@i">

                                            @i

                                        </a>

                                    </li>
                                }
                            }


                            <!-- NEXT -->

                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@search"
                                       asp-route-status="@status"
                                       asp-route-checkInDate="@checkInDate"
                                       asp-route-checkOutDate="@checkOutDate"
                                       asp-route-sortOrder="@sortOrder"
                                       asp-route-page="@(currentPage + 1)">

                                        Next

                                    </a>

                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        Next
                                    </span>

                                </li>
                            }

                        </ul>

                    </nav>

                </div>

            </div>

        </div>
    }

</div>