@model HotelManagementSystem.Models.Bill

@{
    ViewData["Title"] = "Invoice";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Invoice</h2>
            <p class="text-muted mb-0">
                Invoice #@Model.Id
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                onclick="window.print()">
            Print Invoice
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <div class="row mb-4">
                <div class="col-md-6">
                    <h4>Hotel Management System</h4>
                    <p class="mb-0">Hotel Management System</p>
                    <p class="mb-0">Nepal</p>
                </div>

                <div class="col-md-6 text-md-end">
                    <p class="mb-1">
                        <strong>Invoice:</strong>
                        #@Model.Id
                    </p>

                    <p class="mb-0">
                        <strong>Date:</strong>
                        @Model.BillDate.ToString("dd MMM yyyy")
                    </p>
                </div>
            </div>

            <hr />

            @if (Model.Booking != null)
            {
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h5>Customer Details</h5>

                        <p class="mb-1">
                            <strong>Name:</strong>
                            @Model.Booking.Customer?.FullName
                        </p>

                        <p class="mb-1">
                            <strong>Phone:</strong>
                            @Model.Booking.Customer?.Phone
                        </p>

                        <p class="mb-0">
                            <strong>Booking ID:</strong>
                            #@Model.BookingId
                        </p>
                    </div>

                    <div class="col-md-6">
                        <h5>Stay Details</h5>

                        <p class="mb-1">
                            <strong>Room:</strong>
                            @Model.Booking.Room?.RoomNumber
                        </p>

                        <p class="mb-1">
                            <strong>Check-in:</strong>
                            @Model.Booking.CheckInDate.ToString("dd MMM yyyy")
                        </p>

                        <p class="mb-0">
                            <strong>Check-out:</strong>
                            @Model.Booking.CheckOutDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>Room Charge</td>
                            <td class="text-end">
                                Rs. @Model.RoomCharge.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <td>Additional Charge</td>
                            <td class="text-end">
                                Rs. @Model.AdditionalCharge.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <td>Tax</td>
                            <td class="text-end">
                                Rs. @Model.Tax.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th>Total Amount</th>
                            <th class="text-end">
                                Rs. @Model.TotalAmount.ToString("N2")
                            </th>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <strong>Payment Status:</strong>

                    @if (Model.IsPaid)
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Unpaid
                        </span>
                    }
                </div>

                <div class="col-md-6 text-md-end">
                    @if (Model.PaymentDate.HasValue)
                    {
                        <span>
                            <strong>Payment Date:</strong>
                            @Model.PaymentDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                        </span>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    @@media print { {
        .btn {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>