@model HotelManagementSystem.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
}

<div class="hotel-page">

    <div class="page-header">

        <div>
            <p class="page-eyebrow">BOOKING MANAGEMENT</p>

            <h1>Create Booking</h1>

            <p class="page-description">
                Create a new reservation for a hotel guest.
            </p>
        </div>

        <div class="page-actions">

            <a asp-action="Index"
               class="hotel-btn hotel-btn-secondary">
                ← Back to Bookings
            </a>

        </div>

    </div>


    <div class="booking-form-panel">

        <div class="booking-form-header">

            <div class="booking-form-icon">
                📅
            </div>

            <div>
                <h3>Booking Information</h3>

                <p>
                    Select a customer, room and stay dates.
                </p>
            </div>

        </div>


        <form asp-controller="Bookings"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="All"
                 class="alert alert-danger"
                 role="alert">
            </div>


            <div class="booking-form-grid">

                <!-- CUSTOMER -->

                <div class="form-group-full">

                    <label for="CustomerId">
                        Customer
                    </label>

                    <select id="CustomerId"
                            name="CustomerId"
                            class="hotel-input">

                        <option value="">
                            -- Select Customer --
                        </option>

                        @if (ViewBag.Customers != null)
                        {
                            foreach (var customer in ViewBag.Customers)
                            {
                                if (Model.CustomerId == customer.Id)
                                {
                                    <option value="@customer.Id"
                                            selected>
                                        @customer.FullName
                                        @if (!string.IsNullOrWhiteSpace(customer.Phone))
                                        {
                                            @: - @customer.Phone
                                        }
                                    </option>
                                }
                                else
                                {
                                    <option value="@customer.Id">
                                        @customer.FullName
                                        @if (!string.IsNullOrWhiteSpace(customer.Phone))
                                        {
                                            @: - @customer.Phone
                                        }
                                    </option>
                                }
                            }
                        }

                    </select>

                    <span asp-validation-for="CustomerId"
                          class="text-danger">
                    </span>

                </div>


                <!-- ROOM -->

                <div class="form-group-full">

                    <label for="RoomId">
                        Room
                    </label>

                    <select id="RoomId"
                            name="RoomId"
                            class="hotel-input">

                        <option value="">
                            -- Select Room --
                        </option>

                        @if (ViewBag.Rooms != null)
                        {
                            foreach (var room in ViewBag.Rooms)
                            {
                                if (Model.RoomId == room.RoomId)
                                {
                                    <option value="@room.RoomId"
                                            selected>
                                        Room @room.RoomNumber
                                        -
                                        @(room.RoomType?.Name ?? "N/A")
                                        -
                                        Rs. @room.Price.ToString("N2") / night
                                    </option>
                                }
                                else
                                {
                                    <option value="@room.RoomId">
                                        Room @room.RoomNumber
                                        -
                                        @(room.RoomType?.Name ?? "N/A")
                                        -
                                        Rs. @room.Price.ToString("N2") / night
                                    </option>
                                }
                            }
                        }

                    </select>

                    <span asp-validation-for="RoomId"
                          class="text-danger">
                    </span>

                </div>


                <!-- CHECK-IN -->

                <div>

                    <label asp-for="CheckInDate">
                        Check-In Date
                    </label>

                    <input asp-for="CheckInDate"
                           type="date"
                           class="hotel-input"
                           required />

                    <span asp-validation-for="CheckInDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- CHECK-OUT -->

                <div>

                    <label asp-for="CheckOutDate">
                        Check-Out Date
                    </label>

                    <input asp-for="CheckOutDate"
                           type="date"
                           class="hotel-input"
                           required />

                    <span asp-validation-for="CheckOutDate"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="booking-info-box">

                <strong>Booking information</strong>

                <p>
                    The system automatically checks room availability
                    and prevents overlapping bookings for the same room.
                </p>

            </div>


            <div class="booking-form-footer">

                <a asp-action="Index"
                   class="hotel-btn hotel-btn-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="hotel-btn hotel-btn-primary">
                    Confirm Booking
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}