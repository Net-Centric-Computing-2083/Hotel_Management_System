@model HotelManagementSystem.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-primary fw-semibold small text-uppercase">
                Booking Management
            </div>

            <h2 class="fw-bold mb-1">
                Edit Booking
            </h2>

            <p class="text-muted mb-0">
                Update the guest, room or reservation dates.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Bookings
        </a>

    </div>


    <!-- FORM -->
    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white py-3">

                    <h5 class="mb-0">
                        Booking #@Model.Id
                    </h5>

                </div>


                <div class="card-body p-4">

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />


                        <!-- VALIDATION -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- CUSTOMER -->
                        <div class="mb-4">

                            <label asp-for="CustomerId"
                                   class="form-label fw-semibold">
                                Customer
                            </label>

                            <select asp-for="CustomerId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Customer --
                                </option>

                                @foreach (var customer in ViewBag.Customers)
                                {
                                    <option value="@customer.Id">
                                        @customer.FullName
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CustomerId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ROOM -->
                        <div class="mb-4">

                            <label asp-for="RoomId"
                                   class="form-label fw-semibold">
                                Room
                            </label>

                            <select asp-for="RoomId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Room --
                                </option>

                                @foreach (var room in ViewBag.Rooms)
                                {
                                    <option value="@room.RoomId">
                                        Room @room.RoomNumber
                                        -
                                        @room.RoomType?.Name
                                        -
                                        Rs. @room.Price.ToString("N2")
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="RoomId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- DATES -->
                        <div class="row">

                            <!-- CHECK IN -->
                            <div class="col-md-6 mb-4">

                                <label asp-for="CheckInDate"
                                       class="form-label fw-semibold">
                                    Check-In Date
                                </label>

                                <input asp-for="CheckInDate"
                                       type="date"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="CheckInDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- CHECK OUT -->
                            <div class="col-md-6 mb-4">

                                <label asp-for="CheckOutDate"
                                       class="form-label fw-semibold">
                                    Check-Out Date
                                </label>

                                <input asp-for="CheckOutDate"
                                       type="date"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="CheckOutDate"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- INFO -->
                        <div class="alert alert-info">

                            <strong>Note:</strong>

                            Make sure the selected room is available
                            for the entire reservation period.

                            Existing overlapping bookings will be rejected.

                        </div>


                        <!-- BUTTONS -->
                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}