@model IEnumerable<HotelManagementSystem.Models.Room>

@{
    ViewData["Title"] = "Available Rooms";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Available Rooms</h2>
            <p class="text-muted">
                Select a room for your booking.
            </p>
        </div>

        <a asp-controller="Bookings"
           asp-action="SearchRooms"
           class="btn btn-secondary">
            Back to Search
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @{
        var checkInDate = ViewBag.CheckInDate as string;
        var checkOutDate = ViewBag.CheckOutDate as string;
    }

    @if (!string.IsNullOrEmpty(checkInDate) &&
         !string.IsNullOrEmpty(checkOutDate))
    {
        <div class="alert alert-info">
            <strong>Check-in:</strong> @checkInDate
            &nbsp;&nbsp;
            <strong>Check-out:</strong> @checkOutDate
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning">
            <h5>No rooms available</h5>
            <p class="mb-0">
                There are no available rooms for the selected dates.
            </p>
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var room in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                Room @room.RoomNumber
                            </h5>

                            <p class="card-text">
                                <strong>Room Type:</strong>
                                @(room.RoomType?.Name ?? "N/A")
                            </p>

                            <p class="card-text">
                                <strong>Capacity:</strong>
                                @(room.RoomType?.Capacity ?? 0) persons
                            </p>

                            <p class="card-text">
                                <strong>Price per night:</strong>
                                Rs. @room.Price.ToString("N2")
                            </p>

                            <p class="card-text">
                                <strong>Status:</strong>

                                @if (room.IsAvailable)
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Unavailable
                                    </span>
                                }
                            </p>

                        </div>

                        <div class="card-footer bg-white border-0">

                            @if (room.IsAvailable)
                            {
                                <a asp-controller="Bookings"
                                   asp-action="Create"
                                   asp-route-roomId="@room.RoomId"
                                   asp-route-checkInDate="@checkInDate"
                                   asp-route-checkOutDate="@checkOutDate"
                                   class="btn btn-primary w-100">
                                    Book This Room
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100"
                                        disabled>
                                    Unavailable
                                </button>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>