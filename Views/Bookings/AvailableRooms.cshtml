@model IEnumerable<HotelManagementSystem.Models.Room>

@{
    ViewData["Title"] = "Available Rooms";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="text-primary">
                Available Rooms
            </h2>

            <p class="text-muted">
                @ViewBag.CheckInDate
                →
                @ViewBag.CheckOutDate
            </p>
        </div>

        <a asp-action="Create"
           asp-route-checkInDate="@ViewBag.CheckInDate"
           asp-route-checkOutDate="@ViewBag.CheckOutDate"
           class="btn btn-primary">
            Create Booking
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No rooms are available for the selected dates.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var room in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h4>
                                Room @room.RoomNumber
                            </h4>

                            <p class="text-muted mb-2">
                                @room.RoomType?.TypeName
                            </p>

                            <p>
                                <strong>Floor:</strong>
                                @room.Floor
                            </p>

                            <p>
                                <strong>Price:</strong>
                                Rs. @room.RoomType?.PricePerNight
                                / night
                            </p>

                            <span class="badge bg-success">
                                Available
                            </span>

                            <div class="mt-3">

                                <a asp-action="Create"
                                   asp-route-checkInDate="@ViewBag.CheckInDate"
                                   asp-route-checkOutDate="@ViewBag.CheckOutDate"
                                   class="btn btn-primary w-100">
                                    Book This Room
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>