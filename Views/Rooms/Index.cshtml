@model IEnumerable<HotelManagementSystem.Models.Room>

@{
    ViewData["Title"] = "Rooms";

    var rooms = Model ?? Enumerable.Empty<HotelManagementSystem.Models.Room>();

    bool isFiltered = ViewBag.Filtered == true;

    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    int? currentRoomType = ViewBag.CurrentRoomType as int?;
    string currentAvailability = ViewBag.CurrentAvailability as string ?? "";
    string currentSort = ViewBag.CurrentSort as string ?? "";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRooms = ViewBag.TotalRooms ?? rooms.Count();

    DateOnly? checkInDate = ViewBag.CheckInDate as DateOnly?;
    DateOnly? checkOutDate = ViewBag.CheckOutDate as DateOnly?;

    var roomTypes = ViewBag.RoomTypes
        as IEnumerable<HotelManagementSystem.Models.RoomType>
        ?? Enumerable.Empty<HotelManagementSystem.Models.RoomType>();
}

<div class="hotel-page">

    <!-- Header -->
    <div class="page-header">

        <div>
            <p class="page-eyebrow">ROOM MANAGEMENT</p>

            <h1>Rooms</h1>

            <p class="page-description">
                Manage rooms, prices and availability.
            </p>
        </div>

        <div class="page-actions">

            <a asp-action="Create"
               class="hotel-btn hotel-btn-primary">
                <span>+</span>
                Add Room
            </a>

        </div>

    </div>


    <!-- Room Summary -->
    <div class="room-summary">

        <div class="room-summary-card">
            <span class="summary-icon">🛏️</span>

            <div>
                <span>Total Rooms</span>

                <strong>
                    @totalRooms
                </strong>
            </div>
        </div>


        <div class="room-summary-card">
            <span class="summary-icon available">✓</span>

            <div>
                <span>Available</span>

                <strong>
                    @rooms.Count(r => r.IsAvailable)
                </strong>
            </div>
        </div>


        <div class="room-summary-card">
            <span class="summary-icon occupied">●</span>

            <div>
                <span>Unavailable</span>

                <strong>
                    @rooms.Count(r => !r.IsAvailable)
                </strong>
            </div>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- FILTER AND SORT PANEL -->
    <!-- ========================================================= -->

    <div class="rooms-filter-panel">

        <div class="rooms-filter-header">

            <div>
                <p class="page-eyebrow">ROOM SEARCH</p>

                <h3>Find Rooms</h3>

                <p>
                    Search, filter and sort hotel rooms.
                </p>
            </div>

            <a asp-action="Index"
               class="hotel-btn hotel-btn-secondary">
                Reset
            </a>

        </div>


        <!-- General Filters -->
        <form asp-action="Index"
              method="get"
              class="rooms-filter-form">

            <!-- Search -->
            <div class="filter-field">

                <label for="search">
                    Room Number
                </label>

                <input type="text"
                       id="search"
                       name="search"
                       value="@currentSearch"
                       placeholder="Search room number..." />

            </div>


            <!-- Room Type -->
            <div class="filter-field">

                <label for="roomTypeId">
                    Room Type
                </label>

                <select id="roomTypeId"
                        name="roomTypeId">

                    <option value="">
                        All Room Types
                    </option>

                    @foreach (var type in roomTypes)
                    {
                        if (currentRoomType == type.RoomTypeId)
                        {
                            <option value="@type.RoomTypeId"
                                    selected>
                                @type.Name
                            </option>
                        }
                        else
                        {
                            <option value="@type.RoomTypeId">
                                @type.Name
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- Availability -->
            <div class="filter-field">

                <label for="availability">
                    Availability
                </label>

                <select id="availability"
                        name="availability">

                    @if (string.IsNullOrEmpty(currentAvailability))
                    {
                        <option value="" selected>
                            All Rooms
                        </option>
                    }
                    else
                    {
                        <option value="">
                            All Rooms
                        </option>
                    }

                    @if (currentAvailability == "available")
                    {
                        <option value="available" selected>
                            Available
                        </option>
                    }
                    else
                    {
                        <option value="available">
                            Available
                        </option>
                    }

                    @if (currentAvailability == "unavailable")
                    {
                        <option value="unavailable" selected>
                            Unavailable
                        </option>
                    }
                    else
                    {
                        <option value="unavailable">
                            Unavailable
                        </option>
                    }

                </select>

            </div>


            <!-- Sorting -->
            <div class="filter-field">

                <label for="sortOrder">
                    Sort By
                </label>

                <select id="sortOrder"
                        name="sortOrder">

                    @if (string.IsNullOrEmpty(currentSort))
                    {
                        <option value="" selected>
                            Room Number ↑
                        </option>
                    }
                    else
                    {
                        <option value="">
                            Room Number ↑
                        </option>
                    }

                    @if (currentSort == "room_desc")
                    {
                        <option value="room_desc" selected>
                            Room Number ↓
                        </option>
                    }
                    else
                    {
                        <option value="room_desc">
                            Room Number ↓
                        </option>
                    }

                    @if (currentSort == "price_asc")
                    {
                        <option value="price_asc" selected>
                            Price: Low to High
                        </option>
                    }
                    else
                    {
                        <option value="price_asc">
                            Price: Low to High
                        </option>
                    }

                    @if (currentSort == "price_desc")
                    {
                        <option value="price_desc" selected>
                            Price: High to Low
                        </option>
                    }
                    else
                    {
                        <option value="price_desc">
                            Price: High to Low
                        </option>
                    }

                    @if (currentSort == "type_asc")
                    {
                        <option value="type_asc" selected>
                            Room Type A-Z
                        </option>
                    }
                    else
                    {
                        <option value="type_asc">
                            Room Type A-Z
                        </option>
                    }

                    @if (currentSort == "type_desc")
                    {
                        <option value="type_desc" selected>
                            Room Type Z-A
                        </option>
                    }
                    else
                    {
                        <option value="type_desc">
                            Room Type Z-A
                        </option>
                    }

                    @if (currentSort == "availability")
                    {
                        <option value="availability" selected>
                            Available First
                        </option>
                    }
                    else
                    {
                        <option value="availability">
                            Available First
                        </option>
                    }

                </select>

            </div>


            <div class="filter-action">

                <button type="submit"
                        class="hotel-btn hotel-btn-primary">
                    Search
                </button>

            </div>

        </form>


        <!-- Date Availability -->
        <div class="date-filter-divider"></div>

        <div class="date-filter-title">

            <div>
                <strong>
                    Check Availability by Date
                </strong>

                <span>
                    Find rooms available during a specific stay.
                </span>
            </div>

        </div>


        <form asp-action="Filter"
              method="get"
              class="rooms-filter-form date-filter-form">

            <!-- Preserve existing search -->
            <input type="hidden"
                   name="search"
                   value="@currentSearch" />

            <input type="hidden"
                   name="roomTypeId"
                   value="@currentRoomType" />

            <!-- Check-in -->
            <div class="filter-field">

                <label for="checkInDate">
                    Check-In Date
                </label>

                <input type="date"
                       id="checkInDate"
                       name="checkInDate"
                       value="@(checkInDate.HasValue
                           ? checkInDate.Value.ToString("yyyy-MM-dd")
                       : "")"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       required />

            </div>


            <!-- Check-out -->
            <div class="filter-field">

                <label for="checkOutDate">
                    Check-Out Date
                </label>

                <input type="date"
                       id="checkOutDate"
                       name="checkOutDate"
                       value="@(checkOutDate.HasValue
                           ? checkOutDate.Value.ToString("yyyy-MM-dd")
                       : "")"
                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                       required />

            </div>


            <!-- Empty space -->
            <div></div>


            <!-- Search -->
            <div class="filter-action">

                <button type="submit"
                        class="hotel-btn hotel-btn-primary">
                    Check Available Rooms
                </button>

            </div>

        </form>

    </div>


    <!-- Availability Result -->
    @if (isFiltered && checkInDate.HasValue && checkOutDate.HasValue)
    {
        <div class="availability-result">

            <div>

                <strong>
                    Availability Results
                </strong>

                <span>
                    @checkInDate.Value.ToString("dd MMM yyyy")
                    -
                    @checkOutDate.Value.ToString("dd MMM yyyy")
                </span>

            </div>

            <div class="availability-count">

                @rooms.Count()
                @(rooms.Count() == 1 ? "room" : "rooms")
                available

            </div>

        </div>
    }


    <!-- Rooms -->
    <div class="rooms-panel">

        <div class="rooms-panel-header">

            <div>

                <h3>
                    @(isFiltered
                        ? "Available Rooms"
                        : "All Rooms")
                </h3>

                <p>

                    @if (isFiltered)
                    {
                        @($"{rooms.Count()} rooms available for selected dates")
                    }
                    else
                    {
                        @($"{totalRooms} rooms registered")
                    }

                </p>

            </div>

        </div>


        @if (!rooms.Any())
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    🛏️
                </div>

                @if (isFiltered)
                {
                    <h3>
                        No rooms available
                    </h3>

                    <p>
                        No rooms are available for the selected
                        dates and filters.
                    </p>

                    <a asp-action="Index"
                       class="hotel-btn hotel-btn-primary">
                        Show All Rooms
                    </a>
                }
                else
                {
                    <h3>
                        No rooms found
                    </h3>

                    <p>
                        Try changing your search or filters.
                    </p>

                    <a asp-action="Create"
                       class="hotel-btn hotel-btn-primary">
                        Add Room
                    </a>
                }

            </div>
        }
        else
        {
            <div class="rooms-grid">

                @foreach (var room in rooms)
                {
                    <div class="room-card">

                        <div class="room-card-top">

                            <div class="room-number">
                                @room.RoomNumber
                            </div>

                            @if (room.IsAvailable)
                            {
                                <span class="room-status available">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="room-status occupied">
                                    Unavailable
                                </span>
                            }

                        </div>


                        <div class="room-card-body">

                            <span class="room-type-label">
                                ROOM TYPE
                            </span>

                            <h3>
                                @(room.RoomType?.Name ?? "N/A")
                            </h3>


                            <div class="room-info">

                                <div>

                                    <span>
                                        Capacity
                                    </span>

                                    <strong>
                                        @(room.RoomType?.Capacity ?? 0)
                                        Guests
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Price
                                    </span>

                                    <strong>
                                        Rs. @room.Price.ToString("N2")
                                        <small>/night</small>
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <div class="room-card-footer">

                            <a asp-action="Details"
                               asp-route-id="@room.RoomId"
                               class="room-action">
                                View
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@room.RoomId"
                               class="room-action">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@room.RoomId"
                               class="room-action room-action-danger">
                                Delete
                            </a>

                        </div>

                    </div>
                }

            </div>


            <!-- ================================================= -->
            <!-- PAGINATION -->
            <!-- ================================================= -->
            @if (totalPages > 1)
            {
                <div class="rooms-pagination">

                    <div class="pagination-info">

                        Showing page
                        <strong>@currentPage</strong>
                        of
                        <strong>@totalPages</strong>

                    </div>


                    <div class="pagination-buttons">

                        @if (currentPage > 1)
                        {
                            @if (isFiltered)
                            {
                                <a asp-action="Filter"
                                   asp-route-checkInDate="@checkInDate"
                                   asp-route-checkOutDate="@checkOutDate"
                                   asp-route-search="@currentSearch"
                                   asp-route-roomTypeId="@currentRoomType"
                                   asp-route-sortOrder="@currentSort"
                                   asp-route-page="@(currentPage - 1)"
                                   class="pagination-button">
                                    ← Previous
                                </a>
                            }
                            else
                            {
                                <a asp-action="Index"
                                   asp-route-search="@currentSearch"
                                   asp-route-roomTypeId="@currentRoomType"
                                   asp-route-availability="@currentAvailability"
                                   asp-route-sortOrder="@currentSort"
                                   asp-route-page="@(currentPage - 1)"
                                   class="pagination-button">
                                    ← Previous
                                </a>
                            }
                        }


                        @for (int i = 1; i <= totalPages; i++)
                        {
                            @if (isFiltered)
                            {
                                <a asp-action="Filter"
                                   asp-route-checkInDate="@checkInDate"
                                   asp-route-checkOutDate="@checkOutDate"
                                   asp-route-search="@currentSearch"
                                   asp-route-roomTypeId="@currentRoomType"
                                   asp-route-sortOrder="@currentSort"
                                   asp-route-page="@i"
                                   class="pagination-button @(i == currentPage ? "active" : "")">
                                    @i
                                </a>
                            }
                            else
                            {
                                <a asp-action="Index"
                                   asp-route-search="@currentSearch"
                                   asp-route-roomTypeId="@currentRoomType"
                                   asp-route-availability="@currentAvailability"
                                   asp-route-sortOrder="@currentSort"
                                   asp-route-page="@i"
                                   class="pagination-button @(i == currentPage ? "active" : "")">
                                    @i
                                </a>
                            }
                        }


                        @if (currentPage < totalPages)
                        {
                            @if (isFiltered)
                            {
                                <a asp-action="Filter"
                                   asp-route-checkInDate="@checkInDate"
                                   asp-route-checkOutDate="@checkOutDate"
                                   asp-route-search="@currentSearch"
                                   asp-route-roomTypeId="@currentRoomType"
                                   asp-route-sortOrder="@currentSort"
                                   asp-route-page="@(currentPage + 1)"
                                   class="pagination-button">
                                    Next →
                                </a>
                            }
                            else
                            {
                                <a asp-action="Index"
                                   asp-route-search="@currentSearch"
                                   asp-route-roomTypeId="@currentRoomType"
                                   asp-route-availability="@currentAvailability"
                                   asp-route-sortOrder="@currentSort"
                                   asp-route-page="@(currentPage + 1)"
                                   class="pagination-button">
                                    Next →
                                </a>
                            }
                        }

                    </div>

                </div>
            }

        }

    </div>

</div>


<!-- ========================================================= -->
<!-- DATE FILTER JAVASCRIPT -->
<!-- ========================================================= -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const checkIn = document.getElementById("checkInDate");
        const checkOut = document.getElementById("checkOutDate");

        if (!checkIn || !checkOut) {
            return;
        }

        function updateCheckoutMinimum() {

            if (!checkIn.value) {
                return;
            }

            const date =
                new Date(checkIn.value + "T00:00:00");

            date.setDate(date.getDate() + 1);

            const year = date.getFullYear();

            const month =
                String(date.getMonth() + 1).padStart(2, "0");

            const day =
                String(date.getDate()).padStart(2, "0");

            const minimumDate =
                `${year}-${month}-${day}`;

            checkOut.min = minimumDate;

            if (checkOut.value &&
                checkOut.value < minimumDate) {

                checkOut.value = minimumDate;
            }
        }

        checkIn.addEventListener(
            "change",
            updateCheckoutMinimum
        );

        updateCheckoutMinimum();
    });
</script>