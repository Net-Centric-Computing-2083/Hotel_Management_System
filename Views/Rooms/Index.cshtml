@model IEnumerable<HotelManagementSystem.Models.Room>

@{
    ViewData["Title"] = "Rooms";

    var rooms = Model ?? Enumerable.Empty<HotelManagementSystem.Models.Room>();

    bool isFiltered = ViewBag.Filtered == true;

    DateOnly? filterCheckIn = ViewBag.CheckInDate as DateOnly?;
    DateOnly? filterCheckOut = ViewBag.CheckOutDate as DateOnly?;
}

<div class="hotel-page">

    <!-- Header -->
    <div class="page-header">

        <div>
            <p class="page-eyebrow">ROOM MANAGEMENT</p>

            <h1>Rooms</h1>

            <p class="page-description">
                Manage rooms, prices and availability.
            </p>
        </div>

        <div class="page-actions">

            <a asp-action="Create"
               class="hotel-btn hotel-btn-primary">
                <span>+</span>
                Add Room
            </a>

        </div>

    </div>


    <!-- Room Summary -->
    <div class="room-summary">

        <div class="room-summary-card">
            <span class="summary-icon">🛏️</span>

            <div>
                <span>Total Rooms</span>

                <strong>
                    @rooms.Count()
                </strong>
            </div>
        </div>


        <div class="room-summary-card">
            <span class="summary-icon available">✓</span>

            <div>
                <span>Available</span>

                <strong>
                    @rooms.Count(r => r.IsAvailable)
                </strong>
            </div>
        </div>


        <div class="room-summary-card">
            <span class="summary-icon occupied">●</span>

            <div>
                <span>Occupied</span>

                <strong>
                    @rooms.Count(r => !r.IsAvailable)
                </strong>
            </div>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- DATE AVAILABILITY FILTER -->
    <!-- ========================================================= -->

    <div class="rooms-filter-panel">

        <div class="rooms-filter-header">

            <div>
                <p class="page-eyebrow">AVAILABILITY SEARCH</p>

                <h3>Check Room Availability</h3>

                <p>
                    Find rooms available for your selected dates.
                </p>
            </div>

            @if (isFiltered)
            {
                <a asp-action="Index"
                   class="hotel-btn hotel-btn-secondary">
                    Show All Rooms
                </a>
            }

        </div>


        <form asp-action="Filter"
              method="get"
              class="rooms-filter-form">

            <div class="filter-field">

                <label for="checkInDate">
                    Check-In Date
                </label>

                <input type="date"
                       id="checkInDate"
                       name="checkInDate"
                       value="@(filterCheckIn.HasValue
                           ? filterCheckIn.Value.ToString("yyyy-MM-dd")
                       : "")"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       required />

            </div>


            <div class="filter-field">

                <label for="checkOutDate">
                    Check-Out Date
                </label>

                <input type="date"
                       id="checkOutDate"
                       name="checkOutDate"
                       value="@(filterCheckOut.HasValue
                           ? filterCheckOut.Value.ToString("yyyy-MM-dd")
                       : "")"
                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                       required />

            </div>


            <div class="filter-action">

                <button type="submit"
                        class="hotel-btn hotel-btn-primary">
                    Search Available Rooms
                </button>

            </div>

        </form>

    </div>


    @if (isFiltered)
    {
        <div class="availability-result">

            <div>
                <strong>Availability Results</strong>

                <span>
                    @filterCheckIn.Value.ToString("dd MMM yyyy")
                    -
                    @filterCheckOut.Value.ToString("dd MMM yyyy")
                </span>
            </div>

            <div class="availability-count">
                @rooms.Count()
                @(rooms.Count() == 1 ? "room" : "rooms")
                available
            </div>

        </div>
    }


    <!-- Rooms -->
    <div class="rooms-panel">

        <div class="rooms-panel-header">

            <div>
                <h3>
                    @(isFiltered ? "Available Rooms" : "All Rooms")
                </h3>

                <p>
                    @rooms.Count()
                    @(rooms.Count() == 1 ? "room" : "rooms")
                    @(isFiltered ? "available for selected dates" : "registered")
                </p>
            </div>

        </div>


        @if (!rooms.Any())
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    🛏️
                </div>

                @if (isFiltered)
                {
                    <h3>No rooms available</h3>

                    <p>
                        No rooms are available for the selected dates.
                        Try another date range.
                    </p>

                    <a asp-action="Index"
                       class="hotel-btn hotel-btn-primary">
                        Show All Rooms
                    </a>
                }
                else
                {
                    <h3>No rooms yet</h3>

                    <p>
                        Add your first hotel room to get started.
                    </p>

                    <a asp-action="Create"
                       class="hotel-btn hotel-btn-primary">
                        Add First Room
                    </a>
                }

            </div>
        }
        else
        {
            <div class="rooms-grid">

                @foreach (var room in rooms)
                {
                    <div class="room-card">

                        <div class="room-card-top">

                            <div class="room-number">
                                @room.RoomNumber
                            </div>

                            @if (room.IsAvailable)
                            {
                                <span class="room-status available">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="room-status occupied">
                                    Occupied
                                </span>
                            }

                        </div>


                        <div class="room-card-body">

                            <span class="room-type-label">
                                ROOM TYPE
                            </span>

                            <h3>
                                @(room.RoomType?.Name ?? "N/A")
                            </h3>


                            <div class="room-info">

                                <div>
                                    <span>Capacity</span>

                                    <strong>
                                        @(room.RoomType?.Capacity ?? 0)
                                        Guests
                                    </strong>
                                </div>


                                <div>
                                    <span>Price</span>

                                    <strong>
                                        Rs. @room.Price.ToString("N2")
                                        <small>/night</small>
                                    </strong>
                                </div>

                            </div>

                        </div>


                        <div class="room-card-footer">

                            <a asp-action="Details"
                               asp-route-id="@room.RoomId"
                               class="room-action">
                                View
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@room.RoomId"
                               class="room-action">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@room.RoomId"
                               class="room-action room-action-danger">
                                Delete
                            </a>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>


<!-- ========================================================= -->
<!-- DATE FILTER VALIDATION -->
<!-- ========================================================= -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const checkIn = document.getElementById("checkInDate");
        const checkOut = document.getElementById("checkOutDate");

        if (!checkIn || !checkOut) {
            return;
        }

        function updateCheckoutMinimum() {

            if (!checkIn.value) {
                return;
            }

            const date = new Date(checkIn.value + "T00:00:00");

            date.setDate(date.getDate() + 1);

            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, "0");
            const day = String(date.getDate()).padStart(2, "0");

            const minimumDate =
                `${year}-${month}-${day}`;

            checkOut.min = minimumDate;

            if (checkOut.value && checkOut.value < minimumDate) {
                checkOut.value = minimumDate;
            }
        }

        checkIn.addEventListener("change", updateCheckoutMinimum);

        updateCheckoutMinimum();
    });
</script>