@model HotelManagementSystem.Models.Room

@{
    ViewData["Title"] = "Edit Room";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h4 class="mb-0">Edit Room</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Edit" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="RoomId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Room Number -->
                        <div class="mb-3">

                            <label asp-for="RoomNumber"
                                   class="form-label">
                                Room Number
                            </label>

                            <input asp-for="RoomNumber"
                                   class="form-control" />

                            <span asp-validation-for="RoomNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Room Type -->
                        <div class="mb-3">

                            <label asp-for="RoomTypeId"
                                   class="form-label">
                                Room Type
                            </label>

                            <select asp-for="RoomTypeId"
                                    class="form-select"
                                    asp-items="ViewBag.RoomTypeId">

                                <option value="">
                                    -- Select Room Type --
                                </option>

                            </select>

                            <span asp-validation-for="RoomTypeId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Price -->
                        <div class="mb-3">

                            <label asp-for="Price"
                                   class="form-label">
                                Price Per Night
                            </label>

                            <input asp-for="Price"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Availability -->
                        <div class="form-check mb-4">

                            <input asp-for="IsAvailable"
                                   class="form-check-input" />

                            <label asp-for="IsAvailable"
                                   class="form-check-label">
                                Room is available
                            </label>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}