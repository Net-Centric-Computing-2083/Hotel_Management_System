@model IEnumerable<HotelManagementSystem.Models.RoomType>

@{
    ViewData["Title"] = "Room Types";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Room Types
            </h1>

            <p class="text-muted mb-0">
                Manage room categories and guest capacity.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Room Type
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div class="display-4 mb-3">
                    🏨
                </div>

                <h4>
                    No Room Types Found
                </h4>

                <p class="text-muted">
                    Start by creating your first room type.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Add Room Type
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var roomType in Model)
            {
                var roomCount =
                    roomType.Rooms?.Count ?? 0;

                <div class="col-md-6 col-xl-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4">

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                mb-3">

                                <div class="fs-1">
                                    🛏️
                                </div>

                                <span class="badge
                                    bg-primary-subtle
                                    text-primary">
                                    @roomCount Rooms
                                </span>

                            </div>


                            <h4 class="fw-bold">
                                @roomType.Name
                            </h4>


                            <p class="text-muted">
                                Hotel room category
                            </p>


                            <div class="mb-2">

                                <strong>
                                    👥 Capacity:
                                </strong>

                                @roomType.Capacity guests

                            </div>


                            <div>

                                <strong>
                                    🛏️ Rooms:
                                </strong>

                                @roomCount

                            </div>

                        </div>


                        <div class="card-footer
                            bg-white
                            border-0
                            p-4
                            pt-0">

                            <div class="d-flex gap-2">

                                <a asp-action="Details"
                                   asp-route-id="@roomType.RoomTypeId"
                                   class="btn btn-outline-secondary
                                    flex-fill">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@roomType.RoomTypeId"
                                   class="btn btn-outline-primary
                                    flex-fill">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@roomType.RoomTypeId"
                                   class="btn btn-outline-danger
                                    flex-fill">
                                    Delete
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>