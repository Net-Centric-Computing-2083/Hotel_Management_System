@model HotelManagementSystem.Models.RoomType

@{
    ViewData["Title"] = "Create Room Type";
}

<div class="container-fluid">

    <div class="mb-4">

        <h1 class="fw-bold">
            Add Room Type
        </h1>

        <p class="text-muted">
            Create a new room category for your hotel.
        </p>

    </div>


    <div class="row">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                                Room Type Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="e.g. Standard, Deluxe, Suite" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Capacity"
                                   class="form-label fw-semibold">
                                Guest Capacity
                            </label>

                            <input asp-for="Capacity"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="e.g. 2" />

                            <span asp-validation-for="Capacity"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Maximum number of guests this room type can accommodate.
                            </div>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Create Room Type
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>


        <div class="col-lg-5 mt-4 mt-lg-0">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h5 class="fw-bold">
                        Room Type Examples
                    </h5>

                    <hr />

                    <div class="mb-3">

                        <strong>Standard</strong>

                        <p class="text-muted mb-0">
                            Suitable for 1–2 guests.
                        </p>

                    </div>

                    <div class="mb-3">

                        <strong>Deluxe</strong>

                        <p class="text-muted mb-0">
                            More spacious room for 2–3 guests.
                        </p>

                    </div>

                    <div>

                        <strong>Suite</strong>

                        <p class="text-muted mb-0">
                            Premium room suitable for families or groups.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}